# App
# Public origin for redirects / magic links when x-forwarded-* is absent.
# Behind Traefik, x-forwarded-host + x-forwarded-proto are preferred.
APP_URL=https://deisy.byldr.co
# NEXT_PUBLIC_APP_URL=
# DEISY_JOBS_URL=
PORT=3010
DATABASE_URL=file:./data/deisy-jobs.db

# Session cookie (min 16 chars)
SESSION_SECRET=change-me-to-a-long-random-string

# Users (bcrypt hashes — generate with: npx tsx scripts/hash-password.ts 'your-password')
# Escape every $ as \$ so Next.js does not expand them.
DEISY_EMAIL=deisy@example.com
DEISY_PASSWORD_HASH=\$2b\$12\$replace_me
RYAN_EMAIL=ryan@example.com
RYAN_PASSWORD_HASH=\$2b\$12\$replace_me

# API bearer tokens (env fallbacks; prefer DB tokens via npm run token:mint)
# INGEST_TOKEN → scopes ingest,read,notes
# READ_TOKEN → scopes read,notes
INGEST_TOKEN=long-random-ingest-token
READ_TOKEN=long-random-read-token

# Resume PDF storage (optional; defaults shown)
# RESUMES_DIR=./data/resumes
# RESUME_URL_SECRET=  # falls back to SESSION_SECRET for signed download URLs

# Optional magic link via Resend
# RESEND_API_KEY=re_xxx
# RESEND_FROM=deisy-jobs <noreply@byldr.co>
